# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Vercel use a pooled URL from Neon / Supabase.
DATABASE_URL="postgresql://codemo:codemo@localhost:5432/codemo?schema=public"

# Docker Compose only — credentials for the bundled postgres service.
# (docker-compose.yml builds DATABASE_URL from these for the app container.)
POSTGRES_DB="codemo"
POSTGRES_USER="codemo"
POSTGRES_PASSWORD="change-me-strong-db-password"

# ─── Auth.js ───────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Set to true when running behind a reverse proxy (Nginx / Docker / VPS).
AUTH_TRUST_HOST=true

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Media storage ─────────────────────────────────────────────────────────
# "local" (VPS, writes to UPLOAD_DIR) or "s3" (Vercel — any S3-compatible bucket)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# S3 / Cloudflare R2 / AWS (only when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""               # e.g. https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""             # public base URL of the bucket, e.g. https://media.example.com
S3_FORCE_PATH_STYLE="false"

# ─── Email (contact form) ──────────────────────────────────────────────────
# Hostinger: smtp.hostinger.com, port 465, SMTP_SECURE=true
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CODEMO Website <no-reply@example.com>"
CONTACT_RECEIVER_EMAIL="contact@example.com"

# ─── First admin (created / updated by `npm run db:seed`) ───────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
